# Database Settings (Supabase PostgreSQL)
# Use port 6543 (pooler) for Docker deployments to avoid IPv6 issues.
# Use port 5432 (direct) only for local/desktop connections.
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres

# JWT Settings
SECRET_KEY=generate_a_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudflare R2 Storage Settings
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=parental-media
R2_ENDPOINT_URL=

# CORS Settings
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5173
